    "index.py": {
      "excludeFiles": "{.venv/**,.env,.env.*,**/*.db,**/*.db-*,**/*.sqlite*,src/static/uploads/**,src/test_*.py,src/app copy.py,.pytest_cache/**,pylint_report*.txt}"
    }
  }
}
